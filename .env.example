# Copy this file to .env.local and paste your key after the = sign.
# Never commit .env.local to GitHub (it's already in .gitignore).
GEMINI_API_KEY=

# Optional: which Gemini model to use. Leave blank for the default (gemini-flash-latest).
GEMINI_MODEL=

# Optional: FloraAPI key for the planner's plant search (https://floraapi.com, free tier).
# Without it, the planner uses our built-in list of 54 Massachusetts native plants.
FLORA_API_KEY=
